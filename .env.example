# Production / Canonical Site URL for SEO, Sitemap, and OpenGraph (no trailing slash)
VITE_SITE_URL=https://sportxtreme-events.vercel.app

# Supabase Client Credentials (Public / Anon only - never use service_role client-side)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Legacy alias also supported by the client:
# VITE_SUPABASE_ANON_KEY=your-anon-jwt-key

# Admin Authentication (configured via Supabase Auth)
VITE_ADMIN_EMAIL=admin@sportxtreme.com
VITE_ADMIN_PASSWORD=admin123

# End-to-End Testing (defaults to local preview server if unset)
TEST_URL=http://127.0.0.1:4173
